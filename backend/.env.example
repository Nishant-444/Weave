# Environment: development | staging | production
APP_ENV=development
APP_NAME="Weave RAG API"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Supabase / PostgreSQL with pgvector
# Direct connection string for asyncpg (e.g., Supabase transaction/session pooler or local Postgres):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Primary LLM Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash

# Fallback LLM Provider: Groq (Activated on Gemini 429 / Quota Exhaustion)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Local Embeddings Configuration (384-dimensional dense vectors)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Chunking Settings
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
